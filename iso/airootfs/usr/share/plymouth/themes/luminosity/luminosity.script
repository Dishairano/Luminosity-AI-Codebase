// Luminosity OS — Plymouth boot-splash ("Grote zonsopkomst").
// Tekent: achtergrond met horizon-gloed, draaiende stralenkrans, deinende zon,
// ronddraaiende voortgangsring, wordmark + tagline + "OPSTARTEN".
// Alles schaalt en lijnt uit op basis van de schermhoogte, zodat het er op elke
// resolutie (laag of hoog) goed uitziet.

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
cx = screen_w / 2;

// Schaalfactor t.o.v. een referentie van 1080px hoog.
scale = screen_h / 1080;
if (scale > 1.6) { scale = 1.6; }
if (scale < 0.5) { scale = 0.5; }

fun scaled(image, factor) {
    return image.Scale(image.GetWidth() * factor, image.GetHeight() * factor);
}
fun place(sprite, image, x, y, z) {
    sprite.SetImage(image);
    sprite.SetX(x - image.GetWidth() / 2);
    sprite.SetY(y - image.GetHeight() / 2);
    sprite.SetZ(z);
    return sprite;
}

// --- Achtergrond (vult het scherm) ---
bg = Sprite(Image("background.png").Scale(screen_w, screen_h));
bg.SetX(0); bg.SetY(0); bg.SetZ(0);

// --- Beelden, vooraf op de juiste maat geschaald ---
sun_image   = scaled(Image("sun.png"),   scale);
rays_image  = scaled(Image("rays.png"),  scale);
ring_image  = scaled(Image("ring.png"),  scale);
title_image = scaled(Image("title.png"), scale);
tag_image   = scaled(Image("tagline.png"), scale);
label_image = scaled(Image("label.png"), scale);

// Verticale opbouw, relatief aan de schermhoogte (gecentreerd blok).
sun_y   = screen_h * 0.42;
title_y = sun_y + sun_image.GetHeight() / 2 + screen_h * 0.085;
tag_y   = title_y + screen_h * 0.045;
label_y = screen_h * 0.90;

rays_sprite = Sprite();
ring_sprite = Sprite();
sun_sprite  = Sprite();
title = Sprite(); place(title, title_image, cx, title_y, 5);
tag   = Sprite(); place(tag,   tag_image,   cx, tag_y,   5);
label = Sprite(); place(label, label_image, cx, label_y, 5);

angle = 0.0;
ring_angle = 0.0;
tick = 0.0;

fun refresh() {
    tick++;
    angle += 0.004;            // stralen draaien langzaam
    ring_angle += 0.03;        // ring draait sneller (activiteit)

    bob = Math.Sin(tick / 28) * 6 * scale;   // deinende zon, relatief geschaald

    place(rays_sprite, rays_image.Rotate(angle),      cx, sun_y + bob, 2);
    place(ring_sprite, ring_image.Rotate(ring_angle), cx, sun_y + bob, 1);
    place(sun_sprite,  sun_image,                     cx, sun_y + bob, 3);

    label.SetOpacity(0.6 + 0.4 * Math.Sin(tick / 18));   // "OPSTARTEN" pulseert
}
Plymouth.SetRefreshFunction(refresh);

fun display_normal() { }
Plymouth.SetDisplayNormalFunction(display_normal);

fun progress_cb(duration, progress) {
    ring_sprite.SetOpacity(0.5 + 0.5 * progress);
}
Plymouth.SetBootProgressFunction(progress_cb);
