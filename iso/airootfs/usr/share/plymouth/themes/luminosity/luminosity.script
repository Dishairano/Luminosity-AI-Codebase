// Luminosity OS — Plymouth boot-splash ("Grote zonsopkomst").
// Tekent: achtergrond met horizon-gloed, draaiende stralenkrans, deinende zon,
// ronddraaiende voortgangsring, wordmark + tagline + "OPSTARTEN".

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
cx = screen_w / 2;
cy = screen_h / 2;

fun place(sprite, image, x, y, z) {
    sprite.SetImage(image);
    sprite.SetX(x - image.GetWidth() / 2);
    sprite.SetY(y - image.GetHeight() / 2);
    sprite.SetZ(z);
    return sprite;
}

// --- Achtergrond (geschaald naar het scherm) ---
bg_image = Image("background.png");
bg_scaled = bg_image.Scale(screen_w, screen_h);
bg = Sprite(bg_scaled);
bg.SetX(0); bg.SetY(0); bg.SetZ(0);

// --- Beelden ---
sun_image   = Image("sun.png");
rays_image  = Image("rays.png");
ring_image  = Image("ring.png");
title_image = Image("title.png");
tag_image   = Image("tagline.png");
label_image = Image("label.png");

// Verticale opbouw: zon-blok iets boven het midden, teksten eronder.
sun_y   = cy - screen_h * 0.10;
title_y = sun_y + 150;
tag_y   = title_y + 38;
label_y = screen_h - 70;

rays_sprite = Sprite();
ring_sprite = Sprite();
sun_sprite  = Sprite();
title = Sprite(); place(title, title_image, cx, title_y, 5);
tag   = Sprite(); place(tag,   tag_image,   cx, tag_y,   5);
label = Sprite(); place(label, label_image, cx, label_y, 5);

angle = 0.0;
ring_angle = 0.0;
tick = 0.0;

fun refresh() {
    tick++;
    angle += 0.004;            // stralen draaien langzaam
    ring_angle += 0.03;        // ring draait sneller (activiteit)

    // deinende zon (bob)
    bob = Math.Sin(tick / 28) * 6;

    rot_rays = rays_image.Rotate(angle);
    place(rays_sprite, rot_rays, cx, sun_y + bob, 2);

    rot_ring = ring_image.Rotate(ring_angle);
    place(ring_sprite, rot_ring, cx, sun_y + bob, 1);

    place(sun_sprite, sun_image, cx, sun_y + bob, 3);

    // "OPSTARTEN" zacht laten pulseren
    label.SetOpacity(0.6 + 0.4 * Math.Sin(tick / 18));
}

Plymouth.SetRefreshFunction(refresh);

// Wachtwoord-prompt (komt op een live-ISO niet voor, maar netjes afgehandeld).
fun display_normal() { }
Plymouth.SetDisplayNormalFunction(display_normal);

// Voortgang van de boot kan de ring-opacity sturen (optioneel, subtiel).
fun progress_cb(duration, progress) {
    ring_sprite.SetOpacity(0.5 + 0.5 * progress);
}
Plymouth.SetBootProgressFunction(progress_cb);
